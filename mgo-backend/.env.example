ENV=development
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIREBASE_WEB_API_KEY=

# ---------------------------------------------------------------------------
# Payment providers (BE-004)
# Obtain from provider dashboards. Use test keys during development.
# Never commit real values to the repository.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — create in Stripe Dashboard > Products (one per paid plan)
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# Frontend redirect URLs for Stripe checkout
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel

# Paystack
PAYSTACK_SECRET_KEY=

# Paystack Plan Codes — create in Paystack Dashboard (one per paid plan)
PAYSTACK_PLAN_PROFESSIONAL=
PAYSTACK_PLAN_ENTERPRISE=

# Frontend redirect URL for Paystack checkout
PAYSTACK_CALLBACK_URL=http://localhost:3000/billing/success